{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge-agent.local/schemas/owner_contract.schema.json",
  "title": "Owner Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "north_star_plain", "in_scope", "out_of_scope", "finish_contract_plain", "assumptions_accepted", "known_unknowns_registered", "polish_round", "status", "owner_signature"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "north_star_plain": {"type": "string", "minLength": 1, "maxLength": 800},
    "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "finish_contract_plain": {"type": "string", "minLength": 1},
    "assumptions_accepted": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "known_unknowns_registered": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "polish_round": {"type": "integer", "minimum": 0, "maximum": 3},
    "status": {"const": "VALID"},
    "owner_signature": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signature"}]}
  },
  "$defs": {
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "plain", "confidence", "lineage"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "plain": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "lineage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["approved_by", "approved_at", "contract_hash", "receipt_hash"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "minLength": 1},
        "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
